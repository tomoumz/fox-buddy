{
  "name": "fox-buddy",
  "version": "1.5.5",
  "description": "A tiny pixel-arcade fox friend who lives above your dock, with his curly-haired twin daughters.",
  "main": "boot.js",
  "scripts": {
    "start": "electron .",
    "package:mac": "electron-packager . \"Fox Buddy\" --platform=darwin --arch=arm64,x64 --icon=assets/icon.icns --app-bundle-id=com.foxbuddy.app --app-category-type=public.app-category.entertainment --extend-info=assets/Info.extra.plist --overwrite --out=dist --ignore=^/dist --ignore=^/preview --ignore=\\.zip$ --ignore=^/updates --ignore=^/scripts --ignore=^/release",
    "package:win": "electron-packager . \"Fox Buddy\" --platform=win32 --arch=x64 --icon=assets/icon.ico --overwrite --out=dist --ignore=^/dist --ignore=^/preview --ignore=\\.zip$",
    "publish-update": "node scripts/publish-update.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.5.0"
  },
  "productName": "Fox Buddy"
}
